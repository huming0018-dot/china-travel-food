# deploy.env.template — 复制为 deploy.env 并填入真实值（deploy.env 不要提交 git）
# 1) Supabase（从 app/.env.local 复制同名值）
NEXT_PUBLIC_SUPABASE_URL=粘贴你的_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=粘贴你的_SERVICE_ROLE_KEY

# 2) 小红书登录态：用挂载文件（compose 已挂 ./xhs_cookies.json）
XHS_COOKIE_FILE=/secrets/xhs_cookies.json

# 3) cookie 失效告警（按需配置，可多通道同时启用；都留空则只在日志打印）
# --- Telegram ---
# 找 @BotFather 创建机器人拿 Bot Token；Chat ID 找 @userinfobot 获取（或把 bot 拉进群用群 chat_id）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 国内服务器直连 Telegram 不通时，填 Bot API 反代地址（如自建 Cloudflare Worker 反代）；留空用官方
TELEGRAM_API_BASE=
# --- 飞书自定义机器人 ---
# 群 设置 → 群机器人 → 添加机器人 → 自定义机器人，复制 Webhook；安全设置建议选"签名校验"并填 Secret
FEISHU_WEBHOOK=
FEISHU_SECRET=
# --- 飞书开放平台应用机器人（推荐，纯 API，不依赖群自定义机器人入口）---
# 在 https://open.feishu.cn/app 创建企业自建应用、添加"机器人"能力、开通
# im:message:send_as_bot 与 im:chat（均免审）、创建版本并发布；
# FEISHU_CHAT_ID 在与机器人建立私聊/拉进群后，由 GET /im/v1/chats 获取。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
# 留空用官方 https://open.feishu.cn/open-apis
FEISHU_API_BASE=
# --- 可选兜底：Bark / Server酱 ---
# Bark 示例：https://api.day.app/你的KEY ；Server酱示例：https://sctapi.ftqq.com/你的KEY.send
ALERT_WEBHOOK=
# 同一类告警冷却秒数（默认 21600=6 小时，防刷屏；任务完成告警只发一次）
ALERT_COOLDOWN_SEC=21600

# 4) 编排
BATCH=10

# 5) 地图API（电话/坐标/营业时间补齐；留空则脚本优雅跳过并告警）
# --- 腾讯位置服务（主）---
# https://lbs.qq.com/ → 控制台 → WebService API Key + SK
TENCENT_MAP_KEY=
TENCENT_MAP_SK=
# --- 高德地图（备）---
# https://console.amap.com/ → 应用管理 → Web服务 Key + 安全密钥(SK)
AMAP_KEY=
AMAP_SK=

# 6) 补齐任务配置
PHONE_FILL_BATCH=100
HOURS_FILL_BATCH=50
COORD_FILL_ENABLED=true
HOURS_FILL_ENABLED=true
