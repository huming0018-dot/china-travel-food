{
  "manifest_version": 3,
  "name": "众包美食家",
  "version": "3.1.0",
  "description": "知情自愿的众包采集插件（v3.1 回流检测+并发互斥）：参与者用自有账号/设备/网络，按服务端下发安全线采集小红书公开笔记与口味评分，经安全RPC回传，回传结果服务端确认、本地校验防止虚假通过。开源可审计。",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://bdwrhshgdeghgyzwpxnl.supabase.co/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "众包美食家",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/onboarding.html",
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
