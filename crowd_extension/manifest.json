{
  "manifest_version": 3,
  "name": "众包美食家",
  "version": "3.4.8",
  "key": "",
  "update_url": "https://bdwrhshgdeghgyzwpxnl.supabase.co/storage/v1/object/public/crowd/updates.xml",
  "description": "知情自愿的众包采集插件（v3.4.8 双形态后台·Firefox 安卓适配 + 回流检测+并发互斥）：参与者用自有账号/设备/网络，按服务端下发安全线采集小红书公开笔记与口味评分，经安全RPC回传，回传结果服务端确认、本地校验防止虚假通过。开源可审计。",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://m.xiaohongshu.com/*",
    "https://bdwrhshgdeghgyzwpxnl.supabase.co/*"
  ],
  "background": {
    "service_worker": "src/background_v348.js",
    "scripts": [
      "src/sampler.js",
      "src/device_profile.js",
      "src/config.js",
      "src/safety_engine.js",
      "src/background_v348.js"
    ]
  },
  "action": {
    "default_title": "众包美食家",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/onboarding.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://m.xiaohongshu.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "crowd-meishijia@huming0018-dot.github.io",
      "strict_min_version": "126.0",
      "update_url": "https://bdwrhshgdeghgyzwpxnl.supabase.co/storage/v1/object/public/crowd/updates-firefox.json",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  }
}