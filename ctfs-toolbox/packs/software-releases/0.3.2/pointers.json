{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "pointers": {
    "/name": {
      "type": "string",
      "maxLength": 250,
      "minLength": 1
    },
    "/tag_name": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1
    },
    "/published_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "/html_url": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1,
      "format": "uri",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/releases(?:/|$)"
    }
  }
}