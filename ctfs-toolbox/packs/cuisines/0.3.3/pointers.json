{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "pointers": {
    "/draft/title": {
      "type": "string",
      "maxLength": 250,
      "minLength": 1
    },
    "/draft/summary": {
      "type": "string",
      "maxLength": 4000,
      "minLength": 1
    },
    "/draft/entity_type": {
      "enum": [
        "venue",
        "item",
        "event",
        "article_claim"
      ]
    },
    "/draft/subject_name": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1
    },
    "/draft/feature_keys": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "/draft/published_at": {
      "type": "string",
      "minLength": 1
    },
    "/evidence": {
      "type": "array",
      "maxItems": 200
    },
    "/canonical_body": {
      "type": "string",
      "maxLength": 500000,
      "minLength": 1
    },
    "/canonical_body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 1
    },
    "/retrieved_at": {
      "type": "string",
      "minLength": 1
    },
    "/revision": {
      "type": "integer",
      "minimum": 1
    },
    "/source_versions": {
      "type": "array",
      "minItems": 1
    }
  }
}