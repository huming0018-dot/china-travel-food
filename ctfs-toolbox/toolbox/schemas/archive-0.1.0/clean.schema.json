{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctfs.toolbox/schemas/clean/0.1.0",
  "title": "CTFS Toolbox CLEAN record",
  "version": "0.1.0",
  "description": "ODS/CLEAN layer version. Must carry a parent_ref to an existing same-project RAW record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project_id", "parent_ref", "content"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["0.1.0"] },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "parent_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "project_id", "record_id"],
      "properties": {
        "layer": { "type": "string", "enum": ["raw"] },
        "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "record_id": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": true
    },
    "lineage": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
