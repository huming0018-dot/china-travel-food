{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctfs.toolbox/schemas/audit/0.1.0",
  "title": "CTFS Toolbox AUDIT record",
  "version": "0.1.0",
  "description": "APP/AUDIT layer version. Parent must be an existing same-project SCORED record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project_id", "parent_ref", "content"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["0.1.0"] },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "parent_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "project_id", "record_id", "version"],
      "properties": {
        "layer": { "type": "string", "enum": ["scored"] },
        "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "record_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": true
    },
    "lineage": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
