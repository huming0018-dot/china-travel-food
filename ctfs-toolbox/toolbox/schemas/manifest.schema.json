{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctfs.toolbox/schemas/manifest/0.4.0",
  "title": "CTFS Toolbox Project Manifest",
  "version": "0.4.0",
  "description": "Versioned project manifest (0.4.0: P2-IMPL-01 contract - storage backend sqlite|postgres with DSN by env-var NAME only and ctfs_* schema namespace; archived 0.2.0/0.3.2/0.3.3 are the ONLY contracts for those schemaVersions). additionalProperties=false everywhere. No dynamic execution keys allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "storage",
    "pipelines"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "0.4.0"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "name",
        "domain",
        "region"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "sqlite",
            "postgres"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dsn_env",
            "schema"
          ],
          "properties": {
            "dsn_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "description": "NAME of an environment variable holding the DSN; the DSN itself never appears in the manifest"
            },
            "schema": {
              "type": "string",
              "pattern": "^ctfs_[a-z0-9_]{1,48}$",
              "description": "dedicated namespace only; public/production schemas refused"
            }
          }
        }
      }
    },
    "crawler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector",
        "timeout_seconds",
        "max_requests",
        "max_bytes"
      ],
      "properties": {
        "connector": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "per_request_max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packs"
      ],
      "properties": {
        "packs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "pipelines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "clean",
        "scored",
        "audit"
      ],
      "properties": {
        "raw": {
          "$ref": "#/definitions/pipelineLayer"
        },
        "clean": {
          "$ref": "#/definitions/pipelineLayer"
        },
        "scored": {
          "$ref": "#/definitions/pipelineLayer"
        },
        "audit": {
          "$ref": "#/definitions/pipelineLayer"
        }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "kind",
              "url"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "connector": {
                "type": "string",
                "minLength": 1
              },
              "expected_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "pipelineLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "0.2.0"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
