{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctfs.toolbox/schemas/manifest/0.3.3",
  "title": "CTFS Toolbox Project Manifest",
  "version": "0.3.3",
  "description": "Versioned project manifest (0.3.2: P1-REVIEW-GATE-03 contract - crawler identity ledger, snapshot sha/cap gates, ontology index escape defense; archived 0.2.0 is the ONLY contract for schemaVersion 0.2.0). additionalProperties=false everywhere. No dynamic execution keys allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "storage",
    "pipelines"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "0.3.3"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "name",
        "domain",
        "region"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "path"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "sqlite"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "postgres": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "crawler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector",
        "timeout_seconds",
        "max_requests",
        "max_bytes"
      ],
      "properties": {
        "connector": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "per_request_max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packs"
      ],
      "properties": {
        "packs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "pipelines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "clean",
        "scored",
        "audit"
      ],
      "properties": {
        "raw": {
          "$ref": "#/definitions/pipelineLayer"
        },
        "clean": {
          "$ref": "#/definitions/pipelineLayer"
        },
        "scored": {
          "$ref": "#/definitions/pipelineLayer"
        },
        "audit": {
          "$ref": "#/definitions/pipelineLayer"
        }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "kind",
              "url"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "connector": {
                "type": "string",
                "minLength": 1
              },
              "expected_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "pipelineLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "0.2.0"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
