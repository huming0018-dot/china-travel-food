{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APP layer record - audit (append-only, pinned parent version)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project_id",
    "layer",
    "schema_kind",
    "record_id",
    "parent_ref",
    "content"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.2.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "layer": {
      "type": "string",
      "const": "APP"
    },
    "schema_kind": {
      "type": "string",
      "const": "audit"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "project_id",
        "record_id",
        "version",
        "hash"
      ],
      "properties": {
        "layer": {
          "type": "string",
          "const": "DW"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
