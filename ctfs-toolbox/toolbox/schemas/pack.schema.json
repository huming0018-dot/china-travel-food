{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctfs.toolbox/schemas/pack/0.1.0",
  "title": "CTFS Toolbox Ontology Pack contract (pure data, versioned, immutable)",
  "version": "0.1.0",
  "description": "Pack metadata contract. Pure data only: no code, no script, no eval keys, no path fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pack_id",
    "version",
    "domain",
    "contract"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "pointers",
        "validation",
        "rubric",
        "expectations"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "type": "string",
              "const": "fields.yaml"
            },
            "minEntries": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "pointers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "type": "string",
              "const": "pointers.json"
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "type": "string",
              "const": "validation.yaml"
            }
          }
        },
        "rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "type": "string",
              "const": "rubric.yaml"
            }
          }
        },
        "expectations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "type": "string",
              "const": "expectations.yaml"
            }
          }
        }
      }
    }
  }
}
