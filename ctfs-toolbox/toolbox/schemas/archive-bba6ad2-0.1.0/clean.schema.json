{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ODS layer record (append-only versions)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project_id", "layer", "record_id", "parent_ref", "content"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "layer": { "type": "string", "const": "ODS" },
    "record_id": { "type": "string", "minLength": 1 },
    "parent_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "project_id", "record_id"],
      "properties": {
        "layer": { "type": "string", "const": "RAW" },
        "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "record_id": { "type": "string", "minLength": 1 }
      }
    },
    "content": { "type": "object", "additionalProperties": true }
  }
}
