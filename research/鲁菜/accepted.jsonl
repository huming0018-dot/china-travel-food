{"name": "东莱·海上", "name_en": "Donglai Haishang", "match_restaurant_id": null, "brand_group": "东莱餐饮集团", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "鲁菜", "胶东菜(福山派)"]], "form": "Casual Dining", "meals": ["午餐", "晚餐", "夜宵"], "ingredients": ["海鲜", "肉禽", "面"], "awards": {"michelin": "无", "black_pearl": 0, "source_url": null}, "special_tags": ["夜宵"], "price_avg": 140, "price_range": "¥120-160", "tier": "中档", "district": "黄浦区", "address": "上海市黄浦区福建中路94号(近广东路)", "business_area": "南京路/北京路", "lat": 31.2325, "lng": 121.4815, "coord_source": "manual", "phone": "02163115800", "booking_method": "电话/到店排队；午市10:30-14:00 晚市17:00-21:30", "signature_dishes": ["油爆海螺", "葱烧海参", "九转大肠", "油淋鸟贝", "海胆", "虾爬子饺子"], "status": "active", "closed_date": null, "closed_source": null, "scores": {"objective": 78.0, "diner": 82.0, "taste": 82.0, "endorsement": 75.0, "soft_ad_penalty": 2.0, "total": 77.7}, "evidence": {"diner_quotes": [{"quote": "油爆海螺是胶东传统名菜，选料考究必须使用活的红皮香螺取肉，只有鲜活香螺肉的口感才能符合脆嫩弹爽的要求。同时对厨师的刀工、火工技艺要求极高。", "dish": "油爆海螺", "source": "新浪上海", "url": "http://sh.sina.com.cn/life/other/2017-12-26/detail-ifypxrpp4083703.shtml", "date": "2017-12-26"}, {"quote": "东莱海上海胆、鸟贝、海螺、海肠等等胶东海鲜以及经典鲁菜是一贯的招牌，海鲜食材大多隔天从当地空运而来，尤其是新鲜原只海胆始终供不应求。手撕鱼干拌菜心菜心很不错，老式椒盐里脊其实就是山东的炸酥肉。", "dish": "海胆/油淋鸟贝/虾爬子饺子", "source": "搜狐(橄榄餐厅评论)", "url": "https://m.sohu.com/n/452761742/", "date": "2016-06-03"}, {"quote": "Tripadvisor 4.6/5，上海市排名第844的餐厅。这家是魔都有名的胶东菜馆，咬一口下去鲜嫩爽滑弹牙酥脆，香气溢满整个口腔。", "dish": "胶东海鲜", "source": "Tripadvisor", "url": "https://tapc.ctrip.com/Restaurant_Review-g308272-d3391090-", "date": "2026-09-02"}], "platform_scores": [{"platform": "Tripadvisor", "score": 4.6, "review_count": null, "url": "https://tapc.ctrip.com/Restaurant_Review-g308272-d3391090-"}], "negative_signals": ["店面老旧、环境一般", "2021年曾传即将搬迁", "晚市夜宵档营业至凌晨2点但午市选择有限"], "soft_ad_flags": [], "traffic_signals": ["开业12年以上的持续经营", "UnTour Food Tours列为上海最佳鲁菜推荐", "隔天空运海鲜、老客复购"]}, "sources": [{"title": "UnTour Food Tours: Shanghai's Best Shandong Cuisine