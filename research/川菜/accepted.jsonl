{"name": "千平平重庆面庄(延平路总店)", "name_en": null, "match_restaurant_id": null, "brand_group": "千平平重庆面庄", "brand_confirmed": true, "scene": "快餐/面食", "cuisine_paths": [["中餐", "川菜", "渝菜(重庆)"]], "form": "快餐简餐", "meals": ["午餐", "晚餐", "夜宵"], "ingredients": ["面"], "awards": {"michelin": "无", "black_pearl": 0, "source_url": null}, "special_tags": [], "price_avg": 43, "price_range": "¥30-55", "tier": "经济", "district": "静安区", "address": "上海市静安区延平路163号(近昌平路地铁站)", "business_area": "曹家渡/延平路", "lat": null, "lng": null, "coord_source": null, "phone": "18721495274", "booking_method": "到店；10:30-23:00，常有团购套餐", "signature_dishes": ["招牌豌杂面", "肥肠面", "牛腩肥肠面", "小酥肉", "脑花"], "status": "active", "closed_date": null, "closed_source": null, "scores": {"objective": 74.0, "diner": 76.0, "taste": 76.0, "endorsement": 45.0, "soft_ad_penalty": 2.0, "total": 70.1}, "evidence": {"diner_quotes": [{"quote": "位于延平路上的重庆小面馆，挺有名的一家小店。主打的重庆豌杂面，辣油炒得很香。双拼的肥肠牛肉面味道很好吃，大肠软糯牛肉劲道，虽然浇头有点少，但胜在味道地道正宗，性价比高。", "dish": "豌杂面/肥肠牛肉面", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=52029580", "date": "2024-05-28"}, {"quote": "延平路和武定路交口，延续了重庆小面的丰富口感和地道人文。碗杂面不错，小酥肉和脑花都是最爱。它们家经常有超值团购套餐，对打工人或游客都很友好。", "dish": "豌杂面/小酥肉/脑花", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?article=69869416", "date": "2024-08-04"}], "platform_scores": [{"platform": "携程美食", "score": null, "review_count": null, "url": "https://m.ctrip.com/webapp/you/community/detail?article=267047516"}], "negative_signals": ["浇头偏少、油偏大", "小店座位少、翻台快", "团购套餐拉低客单"], "soft_ad_flags": ["团购套餐引流"], "traffic_signals": ["延平路老店、本地打工人日常复购"]}, "sources": [{"title": "千平平重庆面庄(延平路总店)", "url": "https://sh.city8.com/cater/8d9khi7952cyb1cdea", "type": "map"}, {"title": "超好吃的重庆小面馆", "url": "https://m.ctrip.com/webapp/you/community/detail?article=52029580", "type": "ugc"}, {"title": "上海地道重庆小面", "url": "https://m.ctrip.com/webapp/you/community/detail?article=69869416", "type": "ugc"}], "data_updated_at": "2026-09-23", "notes": "dis