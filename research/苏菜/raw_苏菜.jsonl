{"name": "福兴荟(King88广场店)", "name_en": "Fuxinghui", "brand_group": "福兴荟", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "苏菜", "淮扬菜"]], "form": "Casual Dining", "meals": ["午餐", "晚餐"], "ingredients": ["河鲜", "肉禽", "豆制品"], "awards": {"michelin": "无", "black_pearl": 0, "source_url": null}, "special_tags": ["可预订"], "price_avg": 208, "price_range": "¥180-250", "price_sources": [{"platform": "携程美食", "value": 208, "url": "https://you.ctrip.com/food/shanghai2/21169164-food.html"}, {"platform": "高德地图", "value": 209, "url": null}], "district": "长宁区", "address": "上海市长宁区长宁路88号KiNG88广场4楼4-04室", "business_area": "中山公园/曹家渡", "lat": 31.228783, "lng": 121.426674, "coord_source": "amap", "phone_raw": "021-62335777", "booking_method": "电话/大众点评", "signature_dishes": ["淮安长鱼", "扬州大煮干丝", "秘制红汤鲥鱼", "蟹粉小笼包", "手剥六百粒虾仁", "八宝葫芦鸭"], "status": "open", "closed_date": null, "closed_source": null, "scores": {"objective": 82, "diner": 78, "taste": 80, "endorsement": 60, "soft_ad_penalty": 3, "platform_credibility": 0.9}, "evidence": {"diner_quotes": [{"quote": "福兴荟在king88广场四楼，主打淮扬菜，环境不管是大厅还是包间都相当的雅致，蛮适合带家里的长辈过来聚一聚。这道是小瓜炒松板肉，里面还加了鸡纵菌，上桌就是一般锅气，松板肉很嫩。", "dish": "小瓜炒松板肉/淮扬正餐", "source": "抖音探店", "url": "https://www.iesdouyin.com/share/video/7623772498702975205", "date": "2026-04-01"}, {"quote": "上海老牌福兴荟，淮扬菜用餐环境给人一种雅致静谧，低调奢华的感觉。不会都是预制的，我们家都是现点现配现烧，毕竟我们家是八年的老店。鸡汁鲜椒大白鱼，这么长一条，店里面是现蒸出来的。", "dish": "鸡汁鲜椒大白鱼/现烧淮扬", "source": "抖音探店", "url": "https://www.iesdouyin.com/share/video/7620623177529699769", "date": "2026-03-24"}], "platform_scores": [{"platform": "高德地图", "score": 4.6, "review_count": null, "url": null}], "negative_signals": ["商场店，环境偏商务", "团购套餐较多，单点性价比一般"], "soft_ad_flags": ["抖音团购推广较多"], "traffic_signals": ["八年老店，多店连锁(King88/人民广场/七宝)", "家庭聚餐/长辈局复购"]}, "sources": [{"title": "福兴荟(King88广场店) - 携程美食", "url": "https://you.ctrip.com/food/shanghai2/21169164-food.html", "type": "platform"}, {"title": "福兴荟398四人餐探店", "url": "https://www.iesdouyin.com/share/video/7623772498702975205", "type": "ugc"}, {"title": "福兴荟八年老店现点现烧", "url": "https://www.iesdouyin.com/share/video/7620623177529699769", "type": "ugc"}], "data_updated_at": "2026-09-23", "notes": "发现来源：由『上海 淮扬菜 推荐 好吃 狮子头 大煮干丝』在搜索中捞到。多店连锁，本样本收King88广场店。淮安长鱼/大煮干丝是淮扬正餐代表。"}
{"name": "狮王府淮扬菜(万象城店)", "name_en": null, "brand_group": "狮王府(南京)", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "苏菜", "淮扬菜"]], "form": "Casual Dining", "meals": ["午餐", "晚餐"], "ingredients": ["肉禽", "河鲜", "豆制品"], "awards": {"michelin": "无", "black_pearl": 0, "source_url": null}, "special_tags": ["可预订", "包间"], "price_avg": 147, "price_range": "¥120-180", "price_sources": [{"platform": "高德地图", "value": 147, "url": null}], "district": "闵行区", "address": "上海市闵行区吴中路1599号万象城5层L501C-L501D", "business_area": "万象城/七宝", "lat": 31.170761, "lng": 121.370484, "coord_source": "amap", "phone_raw": "021-62200377", "booking_method": "电话/大众点评", "signature_dishes": ["清炖狮子头", "蒜香骨", "蟹黄豆腐", "千禧盐水乳鸽", "金陵烧鸭"], "status": "open", "closed_date": null, "closed_source": null, "scores": {"objective": 80, "diner": 72, "taste": 75, "endorsement": 55, "soft_ad_penalty": 5, "platform_credibility": 0.85}, "evidence": {"diner_quotes": [{"quote": "淮扬雅宴，氛围感拉满。坐标吴中路1599号万象城5层，法式中国风装潢超有格调，挑高空间配中央舞台，用餐时还有大提琴演奏。二楼包间私密性强，部分可直视舞台，不管是情侣约会还是家庭聚餐都很合适。", "dish": "淮扬正餐/狮子头", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=274815381", "date": "2026-03-03"}, {"quote": "狮王府招牌必点，千禧盐水乳鸽，而且整个不觉得腻，会觉得很齁咸，真正好调味。干禧的盐水乳鸽是本帮江浙菜镇店之宝。", "dish": "千禧盐水乳鸽", "source": "抖音探店", "url": "https://www.iesdouyin.com/share/video/7645371235806872154", "date": "2026-05-30"}], "platform_scores": [{"platform": "高德地图", "score": 4.6, "review_count": null, "url": null}], "negative_signals": ["南京连锁品牌上海首店，改良偏甜口", "商场店，环境重于口味", "代金券推广密集"], "soft_ad_flags": ["200元代金券12店通用推广", "抖音团购密集"], "traffic_signals": ["南京老牌连锁，上海万象城店", "家庭聚餐/约会场景"]}, "sources": [{"title": "狮王府淮扬菜(万象城店) 携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=274815381", "type": "ugc"}, {"title": "狮王府招牌必点抖音", "url": "https://www.iesdouyin.com/share/video/7645371235806872154", "type": "ugc"}], "data_updated_at": "2026-09-23", "notes": "发现来源：由高德地图搜索淮扬府时捞到狮王府。南京狮王府系上海万象城店，分类归淮扬菜。"}
{"name": "扬州饭店(福建中路店)", "name_en": "YangZhou Restaurant", "brand_group": "扬州饭店", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "苏菜", "淮扬菜"]], "form": "Casual Dining", "meals": ["午餐", "晚餐"], "ingredients": ["肉禽", "河鲜", "豆制品"], "awards": {"michelin": "必比登", "black_pearl": 0, "source_url": "https://www.hunantoday.cn/article/201809/201809061409285098.html"}, "special_tags": [], "price_avg": 131, "price_range": "¥100-160", "price_sources": [{"platform": "携程美食", "value": 141, "url": "https://you.ctrip.com/food/shanghai2/16559391.html"}, {"platform": "城市吧", "value": 131, "url": "https://sh.city8.com/cater/8dafl17956pibf1f5c"}], "district": "黄浦区", "address": "上海市黄浦区福建中路345号(福建中路与南京东路交叉口)", "business_area": "南京东路/人民广场", "lat": null, "lng": null, "coord_source": null, "phone_raw": "021-63225266", "booking_method": "到店排队/电话", "signature_dishes": ["清炖蟹粉狮子头", "扬州干丝", "松子鲈鱼", "红烧狮子头", "翡翠烧麦", "苔条凤尾虾"], "status": "open", "closed_date": null, "closed_source": null, "scores": {"objective": 82, "diner": 85, "taste": 85, "endorsement": 78, "soft_ad_penalty": 0, "platform_credibility": 0.95}, "evidence": {"diner_quotes": [{"quote": "福建中路开了有七十几年的扬州饭店，人均七十几块真的很实惠。干丝一根根就切得很细的，都是手工，讲究的是少油少盐，吃的就是食材的本味。红烧狮子头比拳头还大，都是师傅手工剁肉然后反复捶打才有这种弹性，浓油赤酱看上去好赞。", "dish": "干丝/红烧狮子头", "source": "抖音探店", "url": "https://www.iesdouyin.com/share/video/7682730271448057701", "date": "2026-09-07"}, {"quote": "难怪能连续9年入选米其林，铺满松子的翡翠烧麦，活虾现做的苔条凤尾虾，再配上扬州名菜什锦煮干丝，每道菜都藏着惊喜。能吃出商家选料严苛，刀工考究，把控火候，还原食材本味。", "dish": "翡翠烧麦/苔条凤尾虾/什锦煮干丝", "source": "抖音探店", "url": "https://www.iesdouyin.com/share/video/7679647189731442809", "date": "2026-08-30"}], "platform_scores": [{"platform": "携程美食", "score": null, "review_count": null, "url": "https://you.ctrip.com/food/shanghai2/16559391.html"}], "negative_signals": ["老字号环境老旧，服务国营风格", "饭点排队，拼桌常见"], "soft_ad_flags": [], "traffic_signals": ["70年老店，连续9年米其林必比登", "爷叔阿婆N刷，本地老客为主", "人均70-130高性价比"]}, "sources": [{"title": "扬州饭店(福建中路店) - 携程美食", "url": "https://you.ctrip.com/food/shanghai2/16559391.html", "type": "platform"}, {"title": "70年老牌扬州饭店探店", "url": "https://www.iesdouyin.com/share/video/7682730271448057701", "type": "ugc"}, {"title": "连续9年米其林必比登推荐", "url": "https://www.iesdouyin.com/share/video/7679647189731442809", "type": "ugc"}], "data_updated_at": "2026-09-23", "notes": "发现来源：由『上海 绿杨邨 扬州饭店 老半斋 淮扬菜 老字号』在搜索中捞到。连续9年米其林必比登推介，上海淮扬菜老字号标杆。"}
{"name": "老半斋(福州路店)", "name_en": "Lao Ban Zhai", "brand_group": "老半斋", "brand_confirmed": true, "scene": "正餐/早餐", "cuisine_paths": [["中餐", "苏菜", "淮扬菜"], ["中餐", "苏菜", "苏式汤面/早面"]], "form": "快餐简餐", "meals": ["午餐", "晚餐", "早餐"], "ingredients": ["面", "肉禽", "豆制品"], "awards": {"michelin": "无", "black_pearl": 0, "source_url": null}, "special_tags": [], "price_avg": 48, "price_range": "¥35-60", "price_sources": [{"platform": "携程美食", "value": 44, "url": "https://you.ctrip.com/food/shanghai2/4994065.html"}, {"platform": "高德地图", "value": 51, "url": null}], "district": "黄浦区", "address": "上海市黄浦区福州路600号(福州路与浙江中路交叉口西北角)", "business_area": "人民广场/福州路", "lat": 31.232877, "lng": 121.479332, "coord_source": "amap", "phone_raw": "021-63222809", "booking_method": "到店排队", "signature_dishes": ["肴肉面", "刀鱼汁面", "雪菜黄鱼面", "清炖蟹粉狮子头", "水晶肴肉", "大煮干丝"], "status": "open", "closed_date": null, "closed_source": null, "scores": {"objective": 82, "diner": 80, "taste": 82, "endorsement": 75, "soft_ad_penalty": 0, "platform_credibility": 0.95}, "evidence": {"diner_quotes": [{"quote": "经典老味道肴肉面，面有咬劲，肉很大块，汤头很鲜，真的是眉毛都要掉下来。环境是典型的国营老食堂，常常看到老客人一边看报一边吃面，浓浓的怀旧氛围。", "dish": "肴肉面", "source": "穷游网", "url": "https://m.qyer.com/qtag/2_1635213/", "date": "2026-09-21"}, {"quote": "老半斋算是上海比较早供应淮扬菜的，环境就是国营老食堂的样子，很多上了年纪的人经常光顾就知道味道很正宗了，八仙桌都坐满，老客人会一边看报纸一边吃面。", "dish": "肴肉面/冷馄饨", "source": "上海热线", "url": "http://m.online.sh.cn/life/content/2016-07/21/content_7949131_13.htm", "date": "2016-07-21"}], "platform_scores": [{"platform": "Trip.com", "score": 4.4, "review_count": null, "url": "https://tw.trip.com/restaurant/china/shanghai/detail/laobanzhai-11142815/"}, {"platform": "高德地图", "score": 4.6, "review_count": null, "url": null}], "negative_signals": ["国营老食堂环境老旧", "服务员态度冷淡，催单", "老字号品控不稳定"], "soft_ad_flags": [], "traffic_signals": ["1905年创立，120年老字号", "老客人固定复购，早市6点开门", "人民广场地段高自然客流"]}, "sources": [{"title": "老半斋(福州路店) - 携程美食", "url": "https://you.ctrip.com/food/shanghai2/4994065.html", "type": "platform"}, {"title": "到老半斋吃面 - 澎湃