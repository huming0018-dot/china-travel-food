{"name": "苏浙总会", "name_en": null, "brand_group": "苏浙汇/金萌集团", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "苏菜", "淮扬菜"], ["中餐", "苏菜", "苏菜Fine Dining"]], "form": "Finedining", "meals": ["午餐", "晚餐"], "ingredients": ["河鲜", "肉禽", "汤/煲"], "awards": {"michelin": "无", "black_pearl": 1, "source_url": null}, "special_tags": ["可预订", "包间"], "price_avg": 420, "price_range": "¥350-500", "price_sources": [{"platform": "尚流TATLER", "value": 400, "url": "http://dining.shangliutatler.com:8081/restaurants/%E8%8B%8F%E6%B5%99%E6%80%BB%E4%BC%9A"}], "district": "徐汇区", "address": "上海市徐汇区肇嘉浜路500号(近襄阳南路)", "business_area": "肇嘉浜路/徐家汇", "lat": null, "lng": null, "coord_source": null, "phone_raw": null, "booking_method": "电话/大众点评预订", "signature_dishes": ["清炖蟹粉狮子头", "大煮干丝", "松鼠桂鱼", "水晶肴肉", "文思豆腐"], "status": "open", "closed_date": null, "closed_source": null, "scores": {"objective": 78, "diner": 72, "taste": 80, "endorsement": 85, "soft_ad_penalty": 2, "platform_credibility": 0.9}, "evidence": {"diner_quotes": [{"quote": "一幅贯穿各包房的《夜宴图》，一位意大利设计师，将苏浙总会追求中华古典宫廷元素与现代美学融合的空间设计理念彻底体现。餐厅主打国宴级淮扬菜，推崇以境养味，注重食客的个性化和专属性需求。", "dish": "国宴级淮扬菜", "source": "尚流TATLER", "url": "http://dining.shangliutatler.com:8081/restaurants/%E8%8B%8F%E6%B5%99%E6%80%BB%E4%BC%9A", "date": "2014-02-24"}, {"quote": "进门处华丽水晶灯下是一片温馨的等位区，用餐大厅格局开阔，欧式风格与中国元素巧妙融合。另外加入了鱼唇、火腿、菜心、天麻和麦冬等滋补调料，特别是鱼唇丰富的胶质溶于汤内，令整道汤羹更加清润鲜美，是道营养又美味的功夫菜。", "dish": "功夫汤羹", "source": "尚流TATLER(苏浙总汇)", "url": "http://dining.shangliutatler.com:8081/restaurants/%E8%8B%8F%E6%B5%99%E6%80%BB%E6%B1%87", "date": "2026-09-16"}], "platform_scores": [{"platform": "尚流TATLER", "score": null, "review_count": null, "url": "http://dining.shangliutatler.com:8081/restaurants/%E8%8B%8F%E6%B5%99%E6%80%BB%E4%BC%9A"}], "negative_signals": ["品牌偏老派，部分年轻人觉得审美过时", "商场店环境嘈杂"], "soft_ad_flags": [], "traffic_signals": ["老牌高端淮扬，商务宴请稳定"]}, "sources": [{"title": "苏浙总会 - 尚流TATLER", "url": "http://dining.shangliutatler.com:8081/restaurants/%E8%8B%8F%E6%B5%99%E6%80%BB%E4%BC%9A", "t