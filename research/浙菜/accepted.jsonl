{"name": "桂满陇·杭州小馆(中山公园店)", "name_en": null, "match_restaurant_id": null, "brand_group": "桂满陇", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "浙", "杭帮菜"]], "form": "Casual Dining", "meals": ["午餐", "晚餐"], "ingredients": ["肉禽", "河鲜", "蔬菜/素食"], "awards": {"michelin": "无", "black_pearl": 0, "source_url": null}, "special_tags": ["可预订"], "price_avg": 80, "price_range": "¥60-100", "tier": "平价", "district": "长宁区", "address": "上海市长宁区长宁路1018号龙之梦城市生活中心8楼", "business_area": "中山公园", "lat": null, "lng": null, "coord_source": null, "phone": "4008777257", "booking_method": "大众点评/到店排队；饭点常排队", "signature_dishes": ["吮指鸡爪", "东坡草扎肉", "招牌石锅杭椒牛蛙", "黑猪鲜肉小笼包", "现炸糖醋雪花里脊", "叫花鸡"], "status": "active", "closed_date": null, "closed_source": null, "scores": {"objective": 72.0, "diner": 65.0, "taste": 65.0, "endorsement": 50.0, "soft_ad_penalty": 8.0, "total": 58.3}, "evidence": {"diner_quotes": [{"quote": "吮指鸡爪一份3个，鸡爪酥糯脱骨，甜口很入味。东坡草扎肉肥瘦相间的五花肉，软糯入味。招牌石锅杭椒牛蛙上来滋滋冒烟，牛蛙微辣鲜嫩。黑猪鲜肉小笼包一口汁水，黑猪肉很香。", "dish": "吮指鸡爪/东坡草扎肉", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=231109089", "date": "2025-11-22"}, {"quote": "招牌现炸糖醋雪花里脊，炸得酥脆的外壳配上酸甜酱汁，一口沦陷。咖喱大虾配脆油条，虾超大只Q弹，裹满咖喱汁配香脆油条。", "dish": "糖醋里脊/咖喱大虾", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=210471731", "date": "2025-10-09"}], "platform_scores": [{"platform": "Trip.com", "score": 4.0, "review_count": null, "url": "https://uk.trip.com/restaurant/china/shanghai/detail/restaurant-133921784/"}], "negative_signals": ["50+分店连锁，改良口味非正宗杭帮", "商场店为主，饭点排队但多为游客/学生", "菜品偏甜偏甜口，本地老饕评价一般", "营销痕迹重，探店笔记量大"], "soft_ad_flags": ["大众连锁+商场店，营销密度高", "探店笔记模板化，'必吃/天花板'话术密集"], "traffic_signals": ["上海50+分店，商场自然客流", "饭点排队但游客占比高"]}, "sources": [{"title": "桂满陇·杭州小馆(中山公园店) 穷游网", "url": "https://m.qyer.com/qtag/2_1635287/", "type": "platform"}, {"title": "桂满陇必点招牌 携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=231109089", "type": "ugc"}, {"title": "电话邦 桂满陇", "url": "https://m.