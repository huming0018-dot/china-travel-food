{"name": "孔乙己酒家(文庙店)", "name_en": null, "match_restaurant_id": null, "brand_group": "孔乙己酒家", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "浙", "绍兴菜"]], "form": "Casual Dining", "meals": ["午餐", "晚餐"], "ingredients": ["肉禽", "河鲜", "豆制品/豆花"], "awards": {"michelin": "无", "black_pearl": 0, "source_url": null}, "special_tags": ["可预订"], "price_avg": 126, "price_range": "¥100-150", "tier": "中档", "district": "黄浦区", "address": "上海市黄浦区老西门街道学宫街34-36号(近文庙)", "business_area": "老西门/文庙", "lat": null, "lng": null, "coord_source": null, "phone": "02163776779 / 02163767979", "booking_method": "电话/到店排队；工作日中午八成座", "signature_dishes": ["茴香豆", "霉干菜烧肉", "金牌太雕鸡", "黄酒", "蟹粉豆腐", "绍三鲜"], "status": "active", "closed_date": null, "closed_source": null, "scores": {"objective": 76.0, "diner": 78.0, "taste": 78.0, "endorsement": 65.0, "soft_ad_penalty": 1.0, "total": 74.9}, "evidence": {"diner_quotes": [{"quote": "茴香豆甜香咸糯，恰到好处，是下酒的好菜。梅干菜烧肉肥瘦相间的五花肉炖得酥烂，不油也不柴，霉干菜吸收了肉汁精华。金牌太雕鸡肉质鲜美。黄酒香而绵，回味悠长。蟹黄豆腐豆腐细腻。", "dish": "茴香豆/霉干菜烧肉/太雕鸡", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=69096658", "date": "2024-08-01"}, {"quote": "老字号绍兴菜，工作日的中午大堂也八成座，有不少还是留座。装潢新的但格局保留老式，八仙桌，看的就亲切。一楼大堂还可以看见湖。特色是绍兴酒，送给每位食客一小小盅黄酒。", "dish": "绍兴黄酒/老字号", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=173164699", "date": "2025-07-19"}], "platform_scores": [{"platform": "Trip.com", "score": 4.5, "review_count": null, "url": "https://tw.trip.com/restaurant/china/shanghai/detail/restaurant-484356/"}, {"platform": "高德地图(瞿溪路店)", "score": 4.6, "review_count": null, "url": null}], "negative_signals": ["文庙店环境老旧", "多分店(文庙/昭化路/瞿溪路/古北)品控可能不一", "绍兴菜口味偏霉鲜，非所有人接受"], "soft_ad_flags": [], "traffic_signals": ["老字号，工作日中午八成座", "老西门文庙商圈自然客流"]}, "sources": [{"title": "孔乙己酒家(文庙店) Trip.com", "url": "https://tw.trip.com/restaurant/china/shanghai/detail/restaurant-484356/", "type": "platform"}, {"title": "电话邦 孔乙己文庙店", "url": "https://www.dianhua.cn/dt/c8ffe9f4d1744efe99