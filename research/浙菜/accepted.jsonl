{"name": "荣府宴(南阳路店)", "name_en": "The House of Rong", "match_restaurant_id": null, "brand_group": "新荣记餐饮集团", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "浙", "台州菜"]], "form": "Finedining", "meals": ["午餐", "晚餐"], "ingredients": ["海鲜", "河鲜", "肉禽"], "awards": {"michelin": "二星", "black_pearl": 2, "source_url": "https://guide.michelin.com/nl/nl/shanghai-municipality/shanghai/restaurant/the-house-of-rong"}, "special_tags": ["可预订", "包间"], "price_avg": 1996, "price_range": "¥1500-2500", "tier": "奢华", "district": "静安区", "address": "上海市静安区南阳路170号贝轩大公馆内(近西康路)", "business_area": "静安寺/南阳路", "lat": null, "lng": null, "coord_source": null, "phone": "02162891717", "booking_method": "电话预订/需提前沟通配菜；无固定菜单，按时令配菜", "signature_dishes": ["黄金脆带鱼", "家烧黄鱼", "沙蒜烧豆面", "樱桃鹅肝", "手撕豆腐", "古城麦饼", "沙琪玛"], "status": "active", "closed_date": null, "closed_source": null, "scores": {"objective": 95.0, "diner": 88.0, "taste": 92.0, "endorsement": 98.0, "soft_ad_penalty": 0.0, "total": 92.6}, "evidence": {"diner_quotes": [{"quote": "新荣记的高端品牌荣府宴，位于南阳路170号优秀历史保护建筑1934年建成的贝轩大公馆内。没有固定菜单，以配菜为主，中午人均1500左右，晚市人均2500左右。", "dish": "台州菜配菜", "source": "抖音探店", "url": "https://www.iesdouyin.com/share/video/7207785149474426171", "date": "2023-03-07"}, {"quote": "黄金脆带鱼是「荣府宴」最受欢迎的菜，外表金黄，外焦里嫩，一口就酥。家烧黄鱼鱼肉软嫩、汁水不会散。", "dish": "黄金脆带鱼/家烧黄鱼", "source": "TimeOut上海", "url": "https://www.timeoutshanghai.cn/features/7077.html", "date": "2026-08-27"}, {"quote": "12个人加服务费人均消费3000，没有开瓶费。选了招牌沙琪玛，外面裹了广东薄餐，外皮油炸让口感更酥。甜品是潮汕白果芋泥。", "dish": "沙琪玛/白果芋泥", "source": "抖音探店", "url": "https://www.iesdouyin.com/share/video/7209205535906843904", "date": "2023-03-11"}], "platform_scores": [{"platform": "携程美食", "score": 4.8, "review_count": null, "url": "https://you.ctrip.com/restaurantlist/shanghai2/s4968-p20.html"}, {"platform": "米其林指南", "score": null, "review_count": null, "url": "https://guide.michelin.com/nl/nl/shanghai-municipality/shanghai/restaurant/the-house-of-rong"}], "negative_signals": ["人均2000+门槛极高", "无固定菜单，价格不透明", "思南公馆另有分店，地址易混淆"], "soft_ad_flags": [], "traffic_signals": ["米其林二星，新荣记集团最高端", "贝轩大公馆历史建筑，环境稀缺"]}, "sources": [{"title": "The House of Rong - MICHELIN Guide", "url": "https://guide.michelin.com/nl/nl/shanghai-municipality/shanghai/restaurant/the-house-of-rong", "type": "official_guide"}, {"title": "TimeOut上海 荣府宴开渔季推荐", "url": "https://www.timeoutshanghai.cn/features/7077.html", "type": "overseas_media"}, {"title": "荣府宴(南阳路店) 穷游网", "url": "https://m.qyer.com/qtag/2_1634958/", "type": "platform"}], "data_updated_at": "2026-09-23", "notes": "【品牌线交叉比对】荣府宴=新荣记集团最高端私宴品牌，挂台州菜/私宴，不挂本帮菜。南阳路店(贝轩大公馆)与思南公馆店(思南路55号)为同名异址分店，本批次收南阳路店。2026沪苏浙米其林二星。人均按携程¥1996保守取中。", "_warnings": []}
{"name": "荣小馆(安达仕店)", "name_en": "Rong Cuisine", "match_restaurant_id": null, "brand_group": "新荣记餐饮集团", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "浙", "台州菜"]], "form": "Casual Dining", "meals": ["午餐", "晚餐"], "ingredients": ["海鲜", "肉禽"], "awards": {"michelin": "必比登", "black_pearl": 0, "source_url": "https://hk.trip.com/restaurant/china/shanghai/detail/rong-cuisine-50715965/"}, "special_tags": ["可预订"], "price_avg": 221, "price_range": "¥180-280", "tier": "高档", "district": "黄浦区", "address": "上海市黄浦区太仓路128号安达仕酒店一楼", "business_area": "新天地/淮海路", "lat": 31.221807, "lng": 121.475721, "coord_source": "amap", "phone": "02162066177", "booking_method": "电话/大众点评；新天地热门建议提前到", "signature_dishes": ["家烧黄鱼", "脆皮乳鸽", "沙蒜烧豆面", "手撕豆腐", "家乡咸菜炒肉丝"], "status": "active", "closed_date": null, "closed_source": null, "scores": {"objective": 80.0, "diner": 72.0, "taste": 78.0, "endorsement": 85.0, "soft_ad_penalty": 2.0, "total": 75.7}, "evidence": {"diner_quotes": [{"quote": "沙蒜豆面真的非常不错，是必点的菜品。家烧深海大黄鱼年糕也很棒，搭配酱汁好好吃。年糕软糯香甜，还不会粘牙。四点半开始取号，四点五十就能进场。要是去晚了，烤乳鸽可就没了。", "dish": "沙蒜豆面/家烧大黄鱼年糕", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=98486186", "date": "2024-11-11"}, {"quote": "整桌最推荐的是家烧大黄鱼配年糕。黄鱼肉质细嫩紧实，没有腥味，家烧的酱汁咸鲜适口带着微微的甜，浓稠挂汁。旁边搭配的年糕软糯Q弹，吸饱了鱼汤的鲜味。沙蒜豆面台州特色经典菜，豆面滑溜溜裹满浓郁酱汁。", "dish": "家烧大黄鱼/沙蒜豆面", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=292683742", "date": "2026-04-14"}], "platform_scores": [{"platform": "Trip.com", "score": 4.1, "review_count": null, "url": "https://hk.trip.com/restaurant/china/shanghai/detail/rong-cuisine-50715965/"}, {"platform": "高德地图", "score": 4.7, "review_count": null, "url": null}], "negative_signals": ["新天地地段游客占比高", "必比登标签带动排队", "与新荣记主店品控有差距"], "soft_ad_flags": ["必比登标签+新天地网红地段，需防游客型排队"], "traffic_signals": ["米其林必比登连续在册", "新天地热门餐厅，周末排队"]}, "sources": [{"title": "荣小馆(安达仕店) Trip.com", "url": "https://hk.trip.com/restaurant/china/shanghai/detail/rong-cuisine-50715965/", "type": "platform"}, {"title": "米其林必比登 荣小馆", "url": "https://tzapp.taizhou.com.cn/webDetails/news?id=3670623&tenantId=64", "type": "official_guide"}], "data_updated_at": "2026-09-23", "notes": "新荣记集团亲民线，米其林必比登。2026沪苏浙必比登推介。坐标取高德。部分携程笔记URL失效，待补。", "_warnings": []}
{"name": "荣家黄鱼面(南京西路店)", "name_en": "Rongjia Noodles Soup with Yellow Croaker", "match_restaurant_id": null, "brand_group": "新荣记餐饮集团", "brand_confirmed": true, "scene": "快餐简餐", "cuisine_paths": [["中餐", "浙", "台州菜"]], "form": "快餐简餐", "meals": ["午餐", "晚餐"], "ingredients": ["海鲜", "面"], "awards": {"michelin": "必比登", "black_pearl": 0, "source_url": "https://guide.michelin.com/ie/en/shanghai-municipality/shanghai/restaurant/rongjia-noodle-soup-with-yellow-croaker"}, "special_tags": [], "price_avg": 150, "price_range": "¥68-180", "tier": "中档", "district": "静安区", "address": "上海市静安区南京西路688号L105A-1室(面朝凤阳路)", "business_area": "南京西路", "lat": 31.23182, "lng": 121.464476, "coord_source": "amap", "phone": "02152799719 / 15618706378", "booking_method": "到店排队", "signature_dishes": ["黄鱼面", "家烧黄鱼", "沙蒜豆面", "家乡咸菜面"], "status": "active", "closed_date": null, "closed_source": null, "scores": {"objective": 82.0, "diner": 75.0, "taste": 82.0, "endorsement": 88.0, "soft_ad_penalty": 0.0, "total": 80.5}, "evidence": {"diner_quotes": [{"quote": "新荣记旗下的小面馆，最便宜的一碗面68元。汤底是用鱼骨熬的，有甘甜的鱼鲜，还加了开洋一起熬煮，这点干货的香气尤其点睛。配料也不是只有简单的几样。", "dish": "黄鱼面", "source": "澎湃新闻", "url": "https://m.thepaper.cn/newsDetail_forward_19696225", "date": "2022-09-01"}, {"quote": "While priced at ¥138, the cost reflects the premium ingredients and meticulous preparation. Rongjia is a sister brand of Xin Rong Ji, a more famous, prestigious one-starred Taizhou restaurant.", "dish": "黄鱼面", "source": "Nomfluence", "url": "https://rachelgouk.com/listings/rongjia-noodles-soup-with-yellow-croaker/", "date": "2025-12-31"}], "platform_scores": [{"platform": "高德地图", "score": 4.7, "review_count": null, "url": null}, {"platform": "米其林指南", "score": null, "review_count": null, "url": "https://guide.michelin.com/ie/en/shanghai-municipality/shanghai/restaurant/rongjia-noodle-soup-with-yellow-croaker"}], "negative_signals": ["68元一碗面在面馆里偏贵", "午市排队，面店翻台快但高峰期需等", "新荣记品牌溢价"], "soft_ad_flags": [], "traffic_signals": ["米其林必比登", "南京西路白领午餐自然客流"]}, "sources": [{"title": "Rongjia Noodles - MICHELIN Guide", "url": "https://guide.michelin.com/ie/en/shanghai-municipality/shanghai/restaurant/rongjia-noodle-soup-with-yellow-croaker", "type": "official_guide"}, {"title": "澎湃新闻：不用去渔港，这几碗海鲜面", "url": "https://m.thepaper.cn/newsDetail_forward_19696225", "type": "news"}, {"title": "Rongjia Noodles - Nomfluence", "url": "https://rachelgouk.com/listings/rongjia-noodles-soup-with-yellow-croaker/", "type": "overseas_media"}], "data_updated_at": "2026-09-23", "notes": "新荣记集团旗下面馆，米其林必比登。与新荣记南京西路店同楼(L1 vs L2)。坐标取高德同楼值。", "_warnings": []}
{"name": "甬府(黄浦店)", "name_en": "Yong Fu", "match_restaurant_id": null, "brand_group": "甬府餐饮集团", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "浙", "宁波菜"]], "form": "Finedining", "meals": ["午餐", "晚餐"], "ingredients": ["海鲜", "河鲜"], "awards": {"michelin": "一星", "black_pearl": 3, "source_url": "https://guide.michelin.com/lv/en/shanghai-municipality/shanghai/restaurant/yong-fu"}, "special_tags": ["可预订", "包间"], "price_avg": 612, "price_range": "¥500-800", "tier": "奢华", "district": "黄浦区", "address": "上海市黄浦区茂名南路59号锦江饭店锦北楼11-12楼", "business_area": "淮海路/长乐路", "lat": 31.220355, "lng": 121.460621, "coord_source": "amap", "phone": "02133566777", "booking_method": "电话预订；商务宴请建议提前订包间", "signature_dishes": ["堂灼十八斩", "宁式十八斩", "干煎带鱼", "雪菜大汤黄鱼", "甬府自制鱼饼", "宁波烤菜", "烟熏葵香鸡"], "status": "active", "closed_date": null, "closed_source": null, "scores": {"objective": 92.0, "diner": 88.0, "taste": 90.0, "endorsement": 96.0, "soft_ad_penalty": 0.0, "total": 90.8}, "evidence": {"diner_quotes": [{"quote": "甬府黄埔店位于老上海锦江饭店中，作为沪上好评的宁波菜，常年米其林一星、黑珍珠三钻。甬府自制鱼饼鱼肉质感很强，淀粉量很少。宁波烤菜摆盘最佳。主打的宁式十八斩，不甜不咸，味道很平衡。", "dish": "宁式十八斩/自制鱼饼", "source": "抖音探店", "url": "https://www.iesdouyin.com/share/video/7216695610890620194", "date": "2023-03-31"}, {"quote": "雪之鲳鱼选用的是下山的白鳞鲷，用宁波特色的雪汁（雪菜）做法体现了咸鲜。黄金螺盐焗方式做了，里面加了一点雪菜的汁水。面条是豆面地瓜粉，比较酸爽。", "dish": "雪汁鲳鱼/盐焗黄金螺", "source": "抖音探店", "url": "https://www.iesdouyin.com/share/video/7234765907510168843", "date": "2023-05-19"}, {"quote": "堂灼十八斩这个菜的蟹黄都要溢出来了，白切膏鱿鱼里面的膏也是肉眼可见的品质感。凉菜烟熏葵香鸡，烟熏香和卤香以及脆皮的口感结合在一起。", "dish": "堂灼十八斩/烟熏葵香鸡", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=228933188", "date": "2025-11-17"}], "platform_scores": [{"platform": "高德地图", "score": 4.6, "review_count": null, "url": null}, {"platform": "Trip.com", "score": 4.7, "review_count": null, "url": "https://ae.trip.com/restaurant/china/shanghai/detail/yong-fu-restaurant-15157584/"}, {"platform": "米其林指南", "score": null, "review_count": null, "url": "https://guide.michelin.com/lv/en/shanghai-municipality/shanghai/restaurant/yong-fu"}], "negative_signals": ["人均600+门槛高", "锦江饭店老建筑，停车不便", "品牌三级分化，需认准总店"], "soft_ad_flags": [], "traffic_signals": ["米其林一星+黑珍珠三钻连续在册", "锦江饭店12楼，商务宴请自然客流"]}, "sources": [{"title": "Yong Fu (Huangpu) - MICHELIN Guide", "url": "https://guide.michelin.com/lv/en/shanghai-municipality/shanghai/restaurant/yong-fu", "type": "official_guide"}, {"title": "甬府(黄浦店) 商户页", "url": "https://you.ctrip.com/food/shanghai2/7017804-dianping70772041.html", "type": "platform"}, {"title": "甬府米其林黑珍珠探店", "url": "https://www.iesdouyin.com/share/video/7216695610890620194", "type": "ugc"}], "data_updated_at": "2026-09-23", "notes": "甬府餐饮集团最高端线，宁波菜天花板。品牌三级：甬府(总店/奢华) > 甬府尊鲜(中端) > 甬府小鲜(亲民)。米其林一星+黑珍珠三钻。坐标取高德。", "_warnings": []}
{"name": "甬府小鲜(静安嘉里中心店)", "name_en": null, "match_restaurant_id": null, "brand_group": "甬府餐饮集团", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "浙", "宁波菜"]], "form": "Casual Dining", "meals": ["午餐", "晚餐"], "ingredients": ["海鲜"], "awards": {"michelin": "必比登", "black_pearl": 0, "source_url": null}, "special_tags": ["可预订"], "price_avg": 200, "price_range": "¥180-250", "tier": "高档", "district": "静安区", "address": "上海市静安区南京西路1515号静安嘉里中心", "business_area": "静安寺/南京西路", "lat": null, "lng": null, "coord_source": null, "phone": null, "booking_method": "大众点评/商场预订", "signature_dishes": ["红膏白蟹", "红烧带鱼", "堂灼十八斩", "宁波烤菜年糕"], "status": "active", "closed_date": null, "closed_source": null, "scores": {"objective": 78.0, "diner": 72.0, "taste": 76.0, "endorsement": 78.0, "soft_ad_penalty": 2.0, "total": 73.8}, "evidence": {"diner_quotes": [{"quote": "上海商务宴请，你可以永远相信他！连续6年米其林必比登推介，黑珍珠、米其林各种光环加持。甬府同款的精致宁波菜人均200+就能get到，性价比拉满。180度全景落地窗，包间和大厅布置清新雅致。", "dish": "宁波菜", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=253149023", "date": "2026-01-09"}, {"quote": "居然是黑珍珠三钻甬府旗下的亲民品牌，人均友好还能吃米其林级宁波菜。红膏白蟹红膏满到溢出来，蟹肉晶莹剔透像果冻。红烧带鱼比我手臂还粗，鱼肉肥到流油。", "dish": "红膏白蟹/红烧带鱼", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=253584843", "date": "2026-01-10"}], "platform_scores": [{"platform": "携程美食", "score": null, "review_count": null, "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=253149023"}], "negative_signals": ["嘉里中心商场店，偏商务", "与甬府总店品控有差距", "必比登标签带动排队"], "soft_ad_flags": ["必比登标签+商场店，探店笔记模板化"], "traffic_signals": ["连续6年米其林必比登", "嘉里中心商务白领自然客流"]}, "sources": [{"title": "甬府小鲜(静安嘉里中心店) 携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=253149023", "type": "ugc"}, {"title": "甬府旗下亲民品牌", "url": "https://www.iesdouyin.com/share/video/7403570375566642444", "type": "ugc"}], "data_updated_at": "2026-09-23", "notes": "甬府集团亲民线，米其林必比登。静安嘉里中心店。电话/坐标待补。", "_warnings": ["来源类型单一（应跨 官方指南/海外媒体/UGC/地图 至少