{"name": "望湘园湖南菜(静安大悦城店)", "name_en": null, "brand_group": "望湘园(SOUTH MEMORY)", "brand_confirmed": true, "scene": "正餐", "cuisine_paths": [["中餐", "湘菜", "湘江流域(长沙)"], ["中餐", "湘菜", "长沙小炒"]], "form": "Casual Dining", "meals": ["午餐", "晚餐"], "ingredients": ["河鲜", "肉禽", "蔬菜/素食"], "awards": {"michelin": "无", "black_pearl": 0, "source_url": null}, "special_tags": ["可预订", "包间"], "price_avg": 103, "price_range": "¥90-120", "price_sources": [{"platform": "携程", "value": 103, "url": "https://you.ctrip.com/food/shanghai2/5007923-dianping155367766.html"}], "district": "静安区", "address": "上海市静安区西藏北路166号静安大悦城南座七楼701-09室", "business_area": "大悦城/曲阜路", "lat": null, "lng": null, "coord_source": null, "phone_raw": "4006608517 / 021-63939677", "booking_method": "电话/大众点评；老牌连锁多店", "signature_dishes": ["鸳鸯鱼头王", "古法姜辣", "辣椒炒黑猪肉", "长沙臭豆腐"], "status": "open", "closed_date": null, "closed_source": null, "scores": {"objective": 70, "diner": 68, "taste": 65, "endorsement": 50, "soft_ad_penalty": 8, "platform_credibility": 0.85}, "evidence": {"diner_quotes": [{"quote": "望湘园大概是魔都湘菜的网红鼻祖、一代排队王。老坛鸳鸯鱼头王鱼肉肥美，红黄剁椒混到一起，鱼头吃得差不多还可以下宽面在汤里，宽面很好吃。", "dish": "鸳鸯鱼头王/下宽面", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=170341242", "date": "2025-07-13"}, {"quote": "望湘园算是魔都湘菜馆的连锁老字号，老坛鸳鸯鱼头王一半剁椒一半藤椒鲜香辣，里面还有筋道面皮；长沙臭豆腐汤汁浓郁。据说沪上最好湘菜馆之一，每次去都会点鸳鸯鱼头，味道比较重但很够味。", "dish": "鸳鸯鱼头王/长沙臭豆腐", "source": "携程笔记", "url": "https://m.ctrip.com/webapp/you/community/detail?articleId=116400691", "date": "2025-01-21"}], "platform_scores": [{"platform": "携程", "score": null, "review_count": null, "url": "https://you.ctrip.com/food/shanghai2/5007923-dianping155367766.html"}], "negative_signals": ["老牌连锁、商场标准化出品，地道老饕评价一般", "辣度上海化改良，非硬核湘味", "营销与连锁推广痕迹重"], "soft_ad_flags": ["全国连锁、大众点评/商场长期推广", "多店标准化、探店模板化"], "traffic_signals": ["商场稳定客流、家庭聚餐为主", "深耕湘菜20年"]}, "sources": [{"title": "望湘园(静安大悦城店) 携程商户页", "url": "https://you.ctrip.com/food/shanghai2/5007923-dianping155367766.html", "type": "platform"}, {"title": "望湘园双