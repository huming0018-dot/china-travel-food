{"name":"老朴家铁锅炖(总店)","match_restaurant_id":990,"brand_group":"黑土屯·老朴家","brand_confirmed":false,"cuisine_paths":[["中餐","东北菜","铁锅炖"]],"form":"Casual Dining","meals":["午餐","晚餐","夜宵"],"ingredients":["火锅锅物","肉禽"],"awards":{"michelin":"无","black_pearl":0},"special_tags":["包间","团购优惠"],"price_avg":88,"price_range":"¥75-100","price_sources":[{"platform":"携程","value":88,"url":"https://you.ctrip.com/food/shanghai2/139043766.html"}],"district":"黄浦区","address":"天津路423-3号","business_area":"人民广场","lat":null,"lng":null,"coord_source":null,"phone_raw":"021-53513577","booking_method":"电话/到店","signature_dishes":["铁锅炖大鹅","铁锅炖排骨鸡","东北烀饼","大拉皮","杀猪菜"],"status":"open","scores":{"objective":82,"diner":82,"taste":80,"endorsement":58,"soft_ad_penalty":6,"platform_credibility":0.88},"evidence":{"diner_quotes":[{"quote":"这家东北铁锅炖的排骨炖得酥烂脱骨，一抿就化，鸡爪软糯黏嘴满满的胶质。一锅里有半只鹅，鹅肉切得很大块，土豆、酸菜、粉丝早就一起炖进去。","dish":"铁锅炖大鹅/排骨","source":"Trip/游侠客","url":"https://hk.trip.com/restaurant/china/shanghai/detail/restaurant-139043766/","date":"2026-08-14"},{"quote":"大片五花肉谁能拒绝，瘦肉不柴肥肉不腻，沾酱汁口感更好。猪肝处理得蛮干净和酸汤意外搭，没有腥味。大块猪血入口鲜嫩弹牙。","dish":"杀猪菜","source":"携程笔记","url":"https://m.ctrip.com/webapp/you/community/detail?articleId=291495737","date":"2026-04-12"}],"platform_scores":[{"platform":"Trip","score":4.4,"review_count":5,"url":"https://hk.trip.com/restaurant/china/shanghai/detail/restaurant-139043766/"}],"negative_signals":["连锁多店，总店/旗舰店/虹口店名实易混","Trip评价样本仅5则","团购双人餐营销存在"],"soft_ad_flags":["2024人气榜上榜营销","团购双人餐投放"],"traffic_signals":"上海多分店，东北老乡复购稳"},"sources":[{"title":"Trip-老朴家铁锅炖旗舰店","url":"https://hk.trip.com/restaurant/china/shanghai/detail/restaurant-139043766/","type":"platform"},{"title":"携程-老朴家铁锅炖旗舰店人均88","url":"https://you.ctrip.com/food/shanghai2/139043766.html","type":"platform"},{"title":"360地图-老朴家铁锅炖(总店)","url":"https://map.360.cn/shenghuo/detail?pguid=0e2f5fbf8145d57b","type":"map"},{"title":"游侠客社区-老朴家铁锅炖","url":"https://bbs.youxiake.com/y/1055000.html","type":"ugc"}],"data_updated_at":"2026-09-23","notes":"补强库id=990